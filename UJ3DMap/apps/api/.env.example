# ─── Database (self-hosted Postgres + PostGIS) ───────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=changeme
PG_DB=uj3dmap

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=8h

# ─── GraphHopper ─────────────────────────────────────────────────────────────
# Default when running GraphHopper locally with: java -jar graphhopper-web-*.jar server config.yml
GRAPHHOPPER_BASE_URL=http://localhost:8989

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
